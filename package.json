{
  "name": "lichess-stats-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Repertoire Builder (repertoire-builder.com): a static site built from real Lichess Opening Explorer data, with opening pages by rating band, strategy guides, and downloadable repertoire packs.",
  "type": "commonjs",
  "main": "src/build.js",
  "scripts": {
    "build": "node src/build.js",
    "build:static": "node src/buildStatic.js",
    "fetch-local-aggregates": "node scripts/fetchLocalAggregates.js",
    "postbuild:static": "node scripts/emDashDensity.js",
    "check-em-dash": "node scripts/emDashDensity.js",
    "serve": "node src/server.js",
    "test": "node --test test/*.test.js",
    "visual-qa": "node scripts/visual-qa.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "chess.js": "1.4.0",
    "cm-chessboard": "8.13.0",
    "esbuild": "^0.28.2",
    "html-validate": "^11.6.2",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
